  factId: fact_sun_coral_reef
  habitatName: Coral Reef Matrix
  category: Biogenic Aragonite Ecosystem
  zoneIndex: 0
  depthRangeText: "10–50 m"
  habitatDescription: A sprawling calcium-carbonate framework constructed over millennia
    by hermatypic scleractinian corals and crustose coralline algae.
  ecologicalSignificance: Acts as a formidable natural breakwater attenuating 97%
    of ocean wave energy, while providing nursery shelter for 25% of all marine species.
  interestingFact: Coral reefs cover less than 0.1% of the world's seafloor, yet
    support more species per unit area than any other marine biome on Earth.
  rdpReward: 75
  habitatPhoto: {fileID: 21300000, guid: 448e208ca3517e648953db4e00c34caa, type: 3}
