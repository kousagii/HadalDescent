  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnvironmentFactTarget
  dataAsset: {fileID: 11400000, guid: 7b62622063ad4dc0be37997d263afbc3, type: 2}
  factId: fact_sun_seagrass_bed
  habitatName: Seagrass Bed
  category: Marine Angiosperm Meadow
  zoneIndex: 0
  depthRangeText: "5–40 m"
  habitatDescription: A towering underwater forest anchored to shallow rock pinnacles,
    spreading gas-filled pneumatocysts toward the sunny surface waters.
  ecologicalSignificance: Operates as a high-volume blue carbon sink, creating vertical
    multi-layered habitats from benthic holdfasts to upper-canopy fronds.
  interestingFact: Under prime cold-water upwelling conditions, giant kelp can grow
    at an astonishing rate of up to 60 cm (2 feet) every single day.
  rdpReward: 75
  habitatPhoto: {fileID: 21300000, guid: 448e208ca3517e648953db4e00c34caa, type: 3}
